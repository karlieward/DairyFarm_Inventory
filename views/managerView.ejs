<!DOCTYPE html>

<html lang="ja"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Inventory Landing (Static Prototype)</title>
  <style>
    :root {
      --bg: #f7f8fa;
      --panel: #ffffff;
      --ink: #0f172a;
      --muted: #64748b;
      --line: #e2e8f0;
      --accent: #2563eb;
      --accent-weak: #93c5fd;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 0; color: var(--ink); background: var(--bg);
      font: 14px/1.4 system-ui, -apple-system, Segoe UI, Roboto, Noto Sans JP, sans-serif;
    }
    .app {
      display: grid; grid-template-columns: 280px 1fr; gap: 16px;
      max-width: 1200px; margin: 24px auto; padding: 0 16px;
    }
    .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); }
    .shadow { box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 2px 8px rgba(16,24,40,.06); }
    .sidebar { padding: 16px; position: sticky; top: 16px; height: fit-content; }
    .search { display: flex; gap: 8px; }
    .search input {
      flex: 1; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px;
    }
    .kicker { font-size: 12px; color: var(--muted); margin: 12px 0 8px; }
    .dept-list { display: grid; gap: 8px; margin-top: 8px; }
    .dept-btn {
      padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: #fff;
      display: flex; align-items: center; justify-content: space-between; cursor: pointer;
    }
    .dept-btn[aria-current="true"] { border-color: var(--accent); outline: 2px solid var(--accent-weak); }

    .main { display: grid; gap: 16px; }

    .products { padding: 16px; }
    .products h2 { margin: 0 0 8px; font-size: 18px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }

    .item { border: 1px solid var(--line); border-radius: 10px; padding: 12px; display: grid; gap: 8px; }
    .item-head { display: grid; grid-template-columns: 48px 1fr; gap: 10px; align-items: center; }
    .thumb { width: 48px; height: 48px; border-radius: 8px; border: 1px dashed var(--line); display: grid; place-items: center; font-size: 20px; }
    .qty { display: inline-flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; }
    .qty button { width: 32px; height: 32px; border: none; background: #f8fafc; cursor: pointer; font-size: 16px; }
    .qty input { width: 40px; text-align: center; border: none; outline: none; background: transparent; }

    .summary { padding: 16px; }
    .summary h3 { margin: 0 0 8px; font-size: 16px; }
    .summary-list { border: 1px solid var(--line); border-radius: 8px; padding: 8px; background: #fff; }

    .inventory { padding: 16px; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { padding: 10px; border-bottom: 1px solid var(--line); text-align: left; }
    th { background: #f1f5f9; }
  </style>
</head>
<body>
  <div class="app">
    <aside class="card shadow sidebar" aria-label="sidebar">
      <div class="kicker">Search</div>
      <div class="search">
        <input id="searchInput" type="search" placeholder="Search medicine..." aria-label="Search medicine">
      </div>
      <div class="kicker">Departments</div>
      <div id="deptList" class="dept-list" role="tablist" aria-label="Departments"><button class="dept-btn" role="tab" aria-selected="true" aria-current="true">Department A</button><button class="dept-btn" role="tab" aria-selected="false" aria-current="false">Department B</button><button class="dept-btn" role="tab" aria-selected="false" aria-current="false">Department C</button><button class="dept-btn" role="tab" aria-selected="false" aria-current="false">Department D</button></div>
    </aside>

    <main class="main">
      <section class="card shadow products" aria-label="Products">
        <h2 id="productsTitle">Department A</h2>
        <div id="productGrid" class="grid"><div class="item" data-item-id="paracetamol"><div class="item-head"><div class="thumb" title="placeholder image">💊</div><div><div style="font-weight:600">Paracetamol</div><div style="color:var(--muted); font-size:12px;">Pain relief</div></div></div><div class="qty"><button type="button">−</button><input type="number" min="0"><button type="button">+</button></div><div style="color: var(--muted); font-size: 12px;">In stock: 120</div></div><div class="item" data-item-id="ibuprofen"><div class="item-head"><div class="thumb" title="placeholder image">💊</div><div><div style="font-weight:600">Ibuprofen</div><div style="color:var(--muted); font-size:12px;">Anti-inflammatory</div></div></div><div class="qty"><button type="button">−</button><input type="number" min="0"><button type="button">+</button></div><div style="color: var(--muted); font-size: 12px;">In stock: 80</div></div><div class="item" data-item-id="cough-syrup"><div class="item-head"><div class="thumb" title="placeholder image">💊</div><div><div style="font-weight:600">Cough Syrup</div><div style="color:var(--muted); font-size:12px;">Expectorant</div></div></div><div class="qty"><button type="button">−</button><input type="number" min="0"><button type="button">+</button></div><div style="color: var(--muted); font-size: 12px;">In stock: 40</div></div></div>
      </section>

      <section class="card shadow summary" aria-label="Summary">
        <h3>Summary for checkout</h3>
        <div id="summaryList" class="summary-list" aria-live="polite"></div>
      </section>

      <section class="card shadow inventory" aria-label="Current Inventory">
        <h3 style="margin-top:0">Current Inventory (Static)</h3>
        <table id="inventoryTable" aria-describedby="Static inventory table">
          <thead>
            <tr><th>Department</th><th>Medicine</th><th>In Stock</th></tr>
          </thead>
          <tbody><tr><td>Department A</td><td>Paracetamol</td><td>120</td></tr><tr><td>Department A</td><td>Ibuprofen</td><td>80</td></tr><tr><td>Department A</td><td>Cough Syrup</td><td>40</td></tr><tr><td>Department B</td><td>Amoxicillin</td><td>55</td></tr><tr><td>Department B</td><td>Azithromycin</td><td>30</td></tr><tr><td>Department B</td><td>Cephalexin</td><td>22</td></tr><tr><td>Department C</td><td>Loratadine</td><td>70</td></tr><tr><td>Department C</td><td>Diphenhydramine</td><td>28</td></tr><tr><td>Department C</td><td>Pseudoephedrine</td><td>18</td></tr><tr><td>Department D</td><td>Omeprazole</td><td>64</td></tr><tr><td>Department D</td><td>Loperamide</td><td>26</td></tr><tr><td>Department D</td><td>Oral Rehydration</td><td>92</td></tr></tbody>
        </table>
      </section>
    </main>
  </div>

  <script>
    const DATA = {
      departments: [
        { id: 'A', name: 'Department A', items: [
          { id:'paracetamol', name:'Paracetamol', note:'Pain relief', stock: 120 },
          { id:'ibuprofen', name:'Ibuprofen', note:'Anti-inflammatory', stock: 80 },
          { id:'cough-syrup', name:'Cough Syrup', note:'Expectorant', stock: 40 },
        ]},
        { id: 'B', name: 'Department B', items: [
          { id:'amoxicillin', name:'Amoxicillin', note:'Antibiotic', stock: 55 },
          { id:'azithromycin', name:'Azithromycin', note:'Antibiotic', stock: 30 },
          { id:'cephalexin', name:'Cephalexin', note:'Antibiotic', stock: 22 },
        ]},
        { id: 'C', name: 'Department C', items: [
          { id:'loratadine', name:'Loratadine', note:'Antihistamine', stock: 70 },
          { id:'diphenhydramine', name:'Diphenhydramine', note:'Antihistamine', stock: 28 },
          { id:'pseudoephedrine', name:'Pseudoephedrine', note:'Decongestant', stock: 18 },
        ]},
        { id: 'D', name: 'Department D', items: [
          { id:'omeprazole', name:'Omeprazole', note:'Acid reducer', stock: 64 },
          { id:'loperamide', name:'Loperamide', note:'Anti-diarrheal', stock: 26 },
          { id:'oral-rehydration', name:'Oral Rehydration', note:'Electrolyte', stock: 92 },
        ]},
      ]
    };

    let activeDept = DATA.departments[0].id;

    const $ = (sel, el=document) => el.querySelector(sel);
    const $$ = (sel, el=document) => Array.from(el.querySelectorAll(sel));

    function renderDepartments() {
      const host = $('#deptList');
      host.innerHTML = '';
      for (const d of DATA.departments) {
        const btn = document.createElement('button');
        btn.className = 'dept-btn';
        btn.setAttribute('role','tab');
        btn.setAttribute('aria-selected', d.id === activeDept);
        btn.setAttribute('aria-current', d.id === activeDept);
        btn.textContent = d.name;
        btn.addEventListener('click', () => { activeDept = d.id; renderDepartments(); renderProducts(); });
        host.appendChild(btn);
      }
    }

    function makeItemCard(item) {
      const wrap = document.createElement('div');
      wrap.className = 'item';

      const head = document.createElement('div');
      head.className = 'item-head';

      const thumb = document.createElement('div');
      thumb.className = 'thumb';
      thumb.title = 'placeholder image';
      thumb.textContent = '💊';

      const nameNote = document.createElement('div');
      nameNote.innerHTML = `<div style="font-weight:600">${item.name}</div><div style="color:var(--muted); font-size:12px;">${item.note}</div>`;

      head.append(thumb, nameNote);

      const qty = document.createElement('div');
      qty.className = 'qty';
      const minus = document.createElement('button'); minus.type='button'; minus.textContent='−';
      const plus = document.createElement('button'); plus.type='button'; plus.textContent='+';
      const input = document.createElement('input'); input.type='number'; input.value='0'; input.min='0';
      minus.addEventListener('click', () => { input.value = Math.max(0, (parseInt(input.value)||0) - 1); updateSummary(); });
      plus.addEventListener('click', () => { input.value = (parseInt(input.value)||0) + 1; updateSummary(); });
      qty.append(minus, input, plus);

      const stock = document.createElement('div');
      stock.style.color = 'var(--muted)';
      stock.style.fontSize = '12px';
      stock.textContent = `In stock: ${item.stock}`;

      wrap.append(head, qty, stock);
      wrap.dataset.itemId = item.id;
      return wrap;
    }

    function renderProducts() {
      const dept = DATA.departments.find(d => d.id === activeDept);
      $('#productsTitle').textContent = dept.name;
      const grid = $('#productGrid');
      grid.innerHTML = '';

      const term = $('#searchInput').value.trim().toLowerCase();
      const items = dept.items.filter(it => it.name.toLowerCase().includes(term));

      if (items.length === 0) {
        const empty = document.createElement('div');
        empty.style.color = 'var(--muted)';
        empty.textContent = 'No matches in this department.';
        grid.appendChild(empty);
        return;
      }

      for (const item of items) {
        grid.appendChild(makeItemCard(item));
      }

      $$('#deptList .dept-btn').forEach((b, i) => {
        const d = DATA.departments[i];
        b.setAttribute('aria-current', d.id === activeDept);
        b.setAttribute('aria-selected', d.id === activeDept);
      });
    }

    function updateSummary() {
      const host = $('#summaryList');
      host.innerHTML = '';
      const items = $$('#productGrid .item');
      const selected = items.filter(it => parseInt(it.querySelector('input[type="number"]').value) > 0);

      if (selected.length === 0) {
        host.innerHTML = '<div style="color:var(--muted); padding:8px;">No items selected.</div>';
        return;
      }

      for (const it of selected) {
        const name = it.querySelector('div[style*="font-weight"]').textContent;
        const qty = it.querySelector('input[type="number"]').value;
        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.justifyContent = 'space-between';
        row.style.padding = '6px 8px';
        row.style.borderBottom = '1px dashed var(--line)';
        row.innerHTML = `<div>${name}</div><div>× ${qty}</div>`;
        host.appendChild(row);
      }
    }

    function renderInventoryTable() {
      const tbody = $('#inventoryTable tbody');
      tbody.innerHTML = '';
      for (const d of DATA.departments) {
        for (const it of d.items) {
          const tr = document.createElement('tr');
          tr.innerHTML = `<td>${d.name}</td><td>${it.name}</td><td>${it.stock}</td>`;
          tbody.appendChild(tr);
        }
      }
    }

    $('#searchInput').addEventListener('input', () => renderProducts());

    renderDepartments();
    renderProducts();
    renderInventoryTable();
  </script>


</body></html>