<style>
  .banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f0f0f0;
    color: #fff;
    padding: 12px 24px;
    font-size: 1.2em;
    height: 64px;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }
  .banner-left,
  .banner-center,
  .banner-right {
    flex: 1;
  }
  .banner-left {
    text-align: left;
  }
  .banner-center {
    text-align: center;
  }
  .banner-right {
    text-align: right;
  }
  .banner-logo {
    height: 150px;
    vertical-align: middle;
  }
  .logout-link,
  .records-btn,
  .back-btn {
    color: #fff;
    background: #3498db;
    text-decoration: none;
    margin-left: 12px;
    padding: 8px 14px;
    border-radius: 6px;
    transition: background 0.2s;
    font-size: 1em;
    display: inline-block;
  }
  .logout-link {
    background: #e74c3c;
  }
  .logout-link:hover {
    background: #c0392b;
  }
  .records-btn:hover,
  .back-btn:hover {
    background: #217dbb;
  }
  #company {
    color: rgb(0, 0, 0);
  }
</style>
<header class="banner">
  <div class="banner-left">
    <div id="company">Wards' Dairies</div>
    <% if (showBack) { %>
      <a href="<%= backUrl %>" class="back-btn">Back</a>
    <% } %>
  </div>
