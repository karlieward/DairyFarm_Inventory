<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manager View</title>
  <style>
    :root {
      --bg: #f7f8fa;
      --panel: #ffffff;
      --ink: #0f172a;
      --line: #e2e8f0;
      --accent: #2563eb;
      --accent-weak: #93c5fd;
      --radius: 12px;
    }
    * { box-sizing: border-box; }
    body { margin:0; padding:16px; font:14px/1.4 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background: var(--bg); color: var(--ink);}
    h1 { margin-bottom: 16px; }
    .btn { padding: 6px 12px; border-radius: 4px; cursor: pointer; border:none; }
    .btn-primary { background-color: var(--accent); color: #fff; }
    .btn-secondary { background-color: #f1f5f9; }
    .search-bar { margin-bottom: 16px; display:flex; gap:8px; }
    .search-bar input { flex:1; padding:6px 8px; border:1px solid var(--line); border-radius:4px; }
    table { width:100%; border-collapse: collapse; background: var(--panel); margin-top:16px; }
    th, td { padding:8px; border-bottom:1px solid var(--line); text-align:left; }
    th { background:#f1f5f9; }
    img { max-width:50px; max-height:50px; border-radius:4px; }
    form.inline { display:inline; }
  </style>
</head>
<body>

  <h1>Manager View</h1>
  <a href="/landing" class="btn btn-primary">Back To Landing</a>

  <!-- Search Form -->
  <form action="/managerView" method="GET" class="search-bar">
    <input type="text" name="search" placeholder="Search by medication name..." value="<%= searchQuery || '' %>">
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <!-- Add Medication -->
  <form action="/managerView/add" method="get" style="margin-bottom:16px;">
    <input type="submit" name="Add" value="Add" class="btn btn-primary">
  </form>

  <!-- Medication Table -->
  <table>
    <thead>
      <tr>
        <% if (inventory.length > 0) { %>
          <% Object.keys(inventory[0]).forEach(col => { %>
            <th><%= col %></th>
          <% }) %>
          <th>Edit</th>
          <th>Delete</th>
        <% } else { %>
          <th>No Data to Display</th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% inventory.forEach(item => { %>
      <tr>
        <% Object.keys(item).forEach(key => { %>
          <td>
            <% if (key === 'image' && item[key]) { %>
              <img src="<%= item[key] %>" alt="Medication Image">
            <% } else { %>
              <%= item[key] %>
            <% } %>
          </td>
        <% }) %>
        <td>
          <form action="/managerView/edit/<%= item.medicationid %>" method="get" class="inline">
            <button type="submit" class="btn btn-secondary">Edit</button>
          </form>
        </td>
        <td>
          <form action="/managerView/delete/<%= item.medicationid %>" method="POST" class="inline" onsubmit="return confirm('Delete this medication?');">
            <button type="submit" class="btn btn-secondary">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

</body>
</html>
