<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<style>
  .banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    color: #fff;
    padding: 12px 24px;
    font-size: 1.2em;
    height: 64px;
    width: 100%;
    box-sizing: border-box;
    position: relative;
    border-bottom-style: solid;
    border-bottom-width: 2px;
    border-bottom-color: #e2e8f0;
    /* Add this for it to sit at the very top */
  }
  .banner-left, .banner-center, .banner-right {
    flex: 1;
  }
  .banner-left {
    text-align: left;
  }
  .banner-center {
    text-align: center;
  }
  .banner-right {
    text-align: right;
  }
  .banner-logo {
    height: 150px;
    vertical-align: middle;
  }
  .logout-link, .records-btn, .back-btn {
    color: #fff;
    background: #3498db;
    text-decoration: none;
    margin-left: 12px;
    padding: 8px 14px;
    border-radius: 6px;
    transition: background 0.2s;
    font-size: 1em;
    display: inline-block;
  }
  .logout-link {
    background: #1c1c1c;
  }
  .logout-link:hover {
    background: #5a5a5a;
  }
  .admin-btn {
    background: #1c1c1c;
  }
    .admin-btn:hover {
      background: #5a5a5a;
    }
  .records-btn:hover, .back-btn:hover {
    background: #217dbb;
  }
  #company {
    color: rgb(0, 0, 0);
    font-family: 'Scala Pro', serif;
    font-size: 40px
  }
  
</style>
<header class="banner">
  <div class="banner-left">
    <div id="company">Wards' Dairies</div> 
    <% if (showBack) { %>
      <a href="<%= backUrl %>" class="back-btn">Back</a>
    <% } %>
  </div>
  <div class="banner-center">
    <img src="images/WardsDairy.png" alt="Logo" class="banner-logo" />
  </div>
  <div class="banner-right">
    <% if (showRecords) { %>
      <a href="/managerView" class="managerView-btn">Records</a>
    <% } %>
    <% if (showLogout) { %>
      <a href="/logout" class="logout-link">Logout</a>
    <% } %>
    <!-- ADMIN BUTTON START -->
      <% 
        //This admin-only button now links to managerView.ejs via /managerView route
        //Functionality: Navigates to managerView.ejs, which should only be accessible to admins.
      %>
      <% if (typeof role !== 'undefined' && role === 'admin') { %>
        <a href="/managerView" class="admin-btn-link">
          <button class="admin-btn" type="button">
            Go to Manager View
          </button>
        </a>
      <% } %>
      <!-- ADMIN BUTTON END -->
  </div>
</header>


</html>