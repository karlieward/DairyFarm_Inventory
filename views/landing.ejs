<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Inventory Landing</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f7f8fa; }
    .app { display: flex; max-width: 1200px; margin: 24px auto; }
    .sidebar { width: 260px; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 16px; margin-right: 16px; }
    .dept-btn { display: block; width: 100%; margin-bottom: 8px; padding: 10px 0; border: 1px solid #e2e8f0; background: #fff; border-radius: 8px; color: #0f172a; cursor: pointer; font-size: 15px; }
    .dept-btn[aria-current="true"] { border-color: #004522; outline: 2px solid #93c5fd; }
    .main { flex: 1; }
    .products { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; padding: 24px; }
    .products h2 { margin-top: 0; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .item { border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; background: #fafcff; }
    .item-head { display: flex; align-items: center; gap: 12px; }
    .thumb { width: 48px; height: 48px; border-radius: 8px; border: 1px dashed #e2e8f0; display: flex; align-items: center; justify-content: center; }
    .thumb img { max-width: 100%; max-height: 100%; border-radius: 8px; }
    .qty { display: flex; align-items: center; gap: 2px; border: 1px solid #e2e8f0; border-radius: 8px; padding: 4px; background: #f8fafc; }
    .qty button { width: 32px; height: 32px; border: none; background: #f7f8fa; color: #2563eb; font-size: 20px; border-radius: 50%; cursor: pointer; transition: background 0.2s; }
    .qty button:hover { background: #e2e8f0; }
    .qty input { width: 40px; height: 28px; text-align: center; border: none; background: transparent; font-size: 16px; outline: none; }
    .summary { background: #fff; border-radius: 12px; border: 1px solid #e2e8f0; margin-top:24px; padding: 24px;}
    .summary-list { margin:8px 0 16px 0;}
    #checkoutBtn { padding:8px 20px; border-radius: 8px; border: none; background:#2563eb; color:#fff; font-weight:600; cursor:pointer;}
    .admin-btn {background: #ef4444; color: #fff; font-weight: 700; padding: 10px 24px; border-radius: 8px; border: none; margin-bottom: 18px; cursor: pointer; transition: background 0.2s; box-shadow: 0 2px 8px rgba(239,68,68,0.07);}
    .admin-btn:hover {background: #b91c1c;}
  </style>
</head>
<body>
    <a href="managerView" class="btn btn-primary mt-3">To Manager View</a>
  <%- include('banner', {
    showLogout: true,
    showRecords: false,
    showBack: false
}) %>

  <div class="app">
    <aside class="sidebar">
      <div style="font-size:13px; margin-bottom:8px;">Departments</div>
      <div id="deptList">
        <% departments.forEach((dept, idx) => { %>
          <button class="dept-btn" data-idx="<%= idx %>" <%= idx === 0 ? 'aria-current="true"' : '' %>><%= dept.deptname %></button>
        <% }); %>
      </div>
    </aside>

    <main class="main">
      <% departments.forEach((dept, idx) => { %>
        <section class="products dept-section" style="<%= idx === 0 ? '' : 'display:none;' %>" data-idx="<%= idx %>">
          <h2><%= dept.deptname %></h2>
          <div class="grid">
            <% dept.items.forEach(item => { %>
              <div class="item" data-item-id="<%= item.id %>">
                <div class="item-head">
                  <div class="thumb">
                    <% if (item.image) { %>
                      <img src="<%= item.image %>" alt="<%= item.medname %>">
                    <% } else { %>
                      💊
                    <% } %>
                  </div>
                  <div>
                    <div style="font-weight:600"><%= item.medname %></div>
                    <div style="font-size:13px; color:#64748b;">In stock: <%= item.quantityonhand %></div>
                  </div>
                </div>
                <div class="qty">
                  <button type="button" class="decrement">−</button>
                  <input type="number" min="0" value="0" class="checkout-qty" data-medname="<%= item.medname %>">
                  <button type="button" class="increment">+</button>
                </div>
              </div>
            <% }); %>
          </div>
        </section>
      <% }); %>
      <section class="summary">
        <h3>Summary for checkout</h3>
        <div id="summaryList" class="summary-list" aria-live="polite"></div>
        <button id="checkoutBtn" type="button">Checkout</button>
      </section>
    </main>
  </div>
  <script>
    // Department switching
    document.querySelectorAll('.dept-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        var idx = btn.getAttribute('data-idx');
        document.querySelectorAll('.dept-section').forEach(sec =>
          sec.style.display = 'none'
        );
        document.querySelector('.dept-section[data-idx="' + idx + '"]').style.display = '';
        document.querySelectorAll('.dept-btn').forEach(b => b.removeAttribute('aria-current'));
        btn.setAttribute('aria-current', 'true');
      });
    });

    // Quantity controls & summary
    const summaryList = document.getElementById('summaryList');
    function updateSummary() {
      summaryList.innerHTML = '';
      document.querySelectorAll('.checkout-qty').forEach((input) => {
        const qty = Number(input.value);
        if (qty > 0) {
          const medname = input.dataset.medname;
          const itemDiv = input.closest('.item');
          const itemId = itemDiv.dataset.itemId;
          summaryList.innerHTML += `<div data-item-id="${itemId}">${medname}: ${qty}</div>`;
        }
      });
    }
    document.querySelectorAll('.decrement').forEach(btn => {
      btn.addEventListener('click', function() {
        var input = btn.nextElementSibling;
        input.value = Math.max(0, Number(input.value) - 1);
        updateSummary();
      });
    });
    document.querySelectorAll('.increment').forEach(btn => {
      btn.addEventListener('click', function() {
        var input = btn.previousElementSibling;
        input.value = Number(input.value) + 1;
        updateSummary();
      });
    });
    document.querySelectorAll('.checkout-qty').forEach(input =>
      input.addEventListener('input', updateSummary)
    );

    // Checkout
    document.getElementById('checkoutBtn').addEventListener('click', function() {
      const checkouts = [];
      document.querySelectorAll('.checkout-qty').forEach((input) => {
        const qty = Number(input.value);
        if (qty > 0) {
          const itemDiv = input.closest('.item');
          checkouts.push({
            medicationid: itemDiv.dataset.itemId,
            quantity: qty
          });
        }
      });
      if (checkouts.length === 0) {
        alert('Nothing to checkout!');
        return;
      }
      fetch('/checkout', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({items: checkouts})
      }).then(response => response.json())
        .then(data => {
          alert(data.message || 'Checkout successful!');
          // Optionally reset UI or reload here
          // location.reload();
        }).catch(() => alert('Checkout failed!'));
    });
  </script>
</body>
</html>
