<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Manager View</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      margin: 0;
      background: #f7f8fa;
    }
    .app {
      max-width: 1400px;
      margin: 24px auto 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 80vh;
    }
    .main {
      width: 100%;
      max-width: 1400px;
      background: #fff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      padding: 10px 10px 6px 10px;
      box-sizing: border-box;
      margin-bottom: 24px;
      box-shadow: 0 1px 2px rgba(16,24,40,.04), 0 2px 8px rgba(16,24,40,.08);
      overflow-x: auto;
    }
    h1 {
      margin-top: 0;
      color: #000000;
      font-size: 1.15em;
      font-weight: bold;
    }
    .btn-primary {
      padding: 5px 10px;
      border-radius: 8px;
      border: none;
      background: #004522;
      color: #fff;
      font-weight: 500;
      cursor: pointer;
      font-size: 0.90em;
      text-decoration: none;
      transition: background 0.2s;
      display: inline-block;
    }
    .btn-primary:hover { background: #056937; }

    .btn-primary.edit-btn{
      padding: 5px 10px;
      border-radius: 8px;
      border: none;
      background: #0077b6;
      color: #fff;
      font-weight: 500;
      cursor: pointer;
      font-size: 0.90em;
      text-decoration: none;
      transition: background 0.2s;
      display: inline-block;
    }
    .btn-primary.edit-btn:hover{
      background: #03045e;
    }
    .btn-primary.delete-btn {
      padding: 5px 24px;
      background: #ef4444;
    }
    .btn-primary.delete-btn:hover {
      background: #b91c1c;
    }
    .table-scroll {
      width: 100%;
      overflow-x: auto;
      margin-top: 0;
    }
    table {
      min-width: 1100px;
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      margin-top: 0;
      font-size: 0.88em;
    }
    th {
      background: #f1f5f9;
      white-space: nowrap;
      font-size: 0.89em;
      font-weight: 600;
      padding: 7px 4px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    td {
      padding: 7px 4px;
      border-bottom: 1px solid #e2e8f0;
      text-align: left;
      vertical-align: middle;
      max-width: 180px;
      word-break: break-word;
      font-size: 0.88em;
    }
    td img { max-width: 36px; max-height: 36px; border-radius: 8px; }
    .edit-btns {
      display: flex;
      gap: 5px;
      justify-content: flex-start;
    }
    /* NAVBAR STYLES */
    .navbar-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: #f8f9fa;
      padding: 10px 16px;
      border-radius: 8px;
      margin-bottom: 18px;
      box-shadow: 0 1px 2px rgba(16,24,40,.03), 0 1px 4px rgba(16,24,40,.06);
      width: 100%;
      box-sizing: border-box;
    }
    .navbar-left,
    .navbar-center,
    .navbar-right {
      display: flex;
      align-items: center;
    }
    .navbar-center {
      flex: 1;
      justify-content: center;
    }
    .navbar-right a, .navbar-right form {
      display: inline-block;
    }
    .navbar-right a {
      margin-right: 8px;
    }
    .search-bar input[type="text"] {
  padding: 5px 8px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
  font-size: 0.95em;
  width: 280px; /* <-- Set the width here */
}

  
    .btn-warning {
      padding: 5px 10px;
      border-radius: 8px;
      border: none;
      background: #004522;
      font-weight: 550;
      cursor: pointer;
      font-size: 0.90em;
      text-decoration: none;
      transition: background 0.2s;
      display: inline-block;
      color: white
    }
    .btn-warning:hover { background: #056937; }
  </style>
</head>
<body>
 <%- include('banner', {
  showLogout: true,
  showRecords: isAdmin,
  showBack: false,
  role: role
}) %>

  <div class="app">
    <main class="main">
      
      <!-- NAVBAR CONTAINER -->
      <div class="navbar-container">
        <div class="navbar-left">
          <a href="/landing" class="btn btn-primary">Back</a>
        </div>
        <div class="navbar-center">
          <form action="/managerView" method="GET" class="search-bar" style="display:flex; gap:6px;">
            <input type="text" name="search" placeholder="Search by medication name..." value="<%= searchQuery || '' %>">
            <button type="submit" class="btn btn-primary">Search</button>
          </form>
        </div>
        <div class="navbar-right">
          <a href="/managerView/add" class="btn btn-primary" style="margin-right:8px;">Add Record</a>
          <form action="/auditLogs" method="get" style="display:inline">
            <button type="submit" class="btn-warning">Audit Logs</button>
          </form>
        </div>
      </div>
      <!-- END NAVBAR CONTAINER -->

      <h1>Manager View</h1>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <% if (inventory.length > 0) { %>
                <% Object.keys(inventory[0]).forEach(col => { %>
                  <th><%= col %></th>
                <% }) %>
                <th>Edit</th>
                <th>Delete</th>
              <% } else { %>
                <th>No Data to Display</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% inventory.forEach(item => { %>
              <tr>
                <% Object.keys(item).forEach(key => { %>
                  <td>
                    <% if (key === "image" && item[key]) { %>
                      <img src="<%= item[key] %>" alt="Image">
                    <% } else { %>
                      <%= item[key] %>
                    <% } %>
                  </td>
                <% }) %>
                <td>
                  <form action="/managerView/edit/<%= item.medicationid %>" method="get" style="display:inline;">
                    <input type="submit" value="Edit" class="btn-primary edit-btn"/>
                  </form>
                </td>
                <td>
                  <form action="/managerView/delete/<%= item.medicationid %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-primary delete-btn">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
